# Server & CORS Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# MySQL Configuration (Standalone or Remote URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=reachinbox
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_URL=
MYSQL_SSL=false

# Redis Configuration (Standalone or Remote Upstash URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
WORKER_CONCURRENCY=5
WORKER_ARTIFICIAL_DELAY_MS=0

# Ethereal SMTP Configuration
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Email Job Retry Configuration
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_DELAY=1000

# Email Rate Limit Configuration
EMAIL_HOURLY_LIMIT=100

# Elasticsearch Configuration (Local or Elastic Cloud)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
ELASTICSEARCH_API_KEY=

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth Credentials
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback
SLACK_WEBHOOK_URL=
